4870ec4bb182"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"ni", "-", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       FractionBox[
        RowBox[{"eD", " ", "\[Phi]D"}], "Te"]], " ", "nF"}]}], "==", "0"}], 
   ",", 
   RowBox[{"{", "\[Phi]D", "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.990969887965198*^9, 3.9909698985072284`*^9}},
