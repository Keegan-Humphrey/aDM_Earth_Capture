Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"\[Phi]D", "\[Rule]", 
    TemplateBox[{
      FractionBox[
       RowBox[{"Te", " ", 
         RowBox[{"(", 
           RowBox[{
             RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Pi]", " ", 
               TemplateBox[{"1"}, "C"]}], "+", 
             RowBox[{"Log", "[", 
               FractionBox["ni", "nF"], "]"}]}], ")"}]}], "eD"], 
      RowBox[{
        TemplateBox[{"1"}, "C"], "\[Element]", 
        TemplateBox[{}, "Integers"]}]},
     "ConditionalExpression"]}], "}"}], "}"}]], "Output",
