Cell["\<\
Story here is: captured dark protons are colder, as the temperature decreases \
the relative density and potential increases, a smaller and smaller potential \
is needed to compensate for the density differrence of the two species. \
\>", "Text",
 CellChangeTimes->{{3.9909693437657356`*^9, 3.9909693525461845`*^9}, {
  3.9909694142854657`*^9, 3.9909694730307055`*^9}, {3.9909695919127316`*^9, 
  3.9909696137953606`*^9}},ExpressionUUID->"5266600e-0341-4162-882f-\
1de5c67b850d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"niT", "=", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       RowBox[{"eD", " ", "\[Phi]D"}], "+", 
       RowBox[{"mpD", " ", "\[Phi]g"}]}], "Ti"]}]], " ", 
   "ni"}]}], "\[IndentingNewLine]", 
 RowBox[{"neT", "=", 
  RowBox[{
   RowBox[{"-", 
    SuperscriptBox["\[ExponentialE]", 
     FractionBox[
      RowBox[{"eD", " ", "\[Phi]D"}], "Te"]]}], " ", "nF"}]}]}], "Input",
 CellChangeTimes->{{3.990969705600441*^9, 3.990969719312505*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"f20524f2-3235-4d95-9ba0-87a6905c5fcd"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{
      RowBox[{"eD", " ", "\[Phi]D"}], "+", 
      RowBox[{"mpD", " ", "\[Phi]g"}]}], "Ti"]}]], " ", "ni"}]], "Output",
 CellChangeTimes->{3.9909697199419165`*^9},
